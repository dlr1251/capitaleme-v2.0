---
import Navbar from '../components/core/layout/Navbar.tsx';
import Footer from '../components/core/layout/Footer.astro';
import ContactBar from '../components/core/layout/ContactBar.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import AnalyticsHead from '../components/core/analytics/AnalyticsHead.astro';
import AnalyticsScripts from '../components/core/analytics/AnalyticsScripts.tsx';
import type { Lang } from '../context/LanguageContext.tsx';
import { getWhatsAppButtonProps } from '../utils/whatsappMessages.js';

export interface Props {
	title: string;
	description?: string;
	lang?: Lang;
	pathname?: string;
	menuData?: any; // Add menuData prop for CLKR layout
	hideWhatsAppOnMobile?: boolean;
}

const { title, description, lang = 'en', pathname, menuData, hideWhatsAppOnMobile = false } = Astro.props;
const currentLang = lang || (Astro.url.pathname.startsWith('/es') ? 'es' : 'en');

// Get current pathname from props or use Astro.url.pathname
const currentPathname = pathname || Astro.url.pathname;

// Generate WhatsApp button props based on current page context
const whatsappProps = getWhatsAppButtonProps(currentPathname, title, currentLang);

---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<!-- Analytics Scripts -->
		<AnalyticsHead />
	</head>
	<body>
		<ContactBar lang={currentLang} />
		<Navbar client:load lang={currentLang} pathname={currentPathname} menuData={menuData} />
		<main>
			<slot />
		</main>
		<Footer lang={currentLang} />
		
	<!-- WhatsApp Floating Button -->
	<WhatsAppButton 
		message={whatsappProps.message}
		lang={whatsappProps.lang}
		pageType={whatsappProps.pageType}
		pageTitle={whatsappProps.pageTitle}
		category={whatsappProps.category}
		hideOnMobile={hideWhatsAppOnMobile}
	/>
		
		<!-- Analytics Tracking Scripts -->
		<AnalyticsScripts 
			client:load
			pageTitle={title}
			pagePath={currentPathname}
		/>
		
	</body>
</html>

