---
import Layout from './Layout.astro';
import HomeMobileNavigation from '../components/home/HomeMobileNavigation.tsx';
import type { Lang } from '../context/LanguageContext.tsx';

export interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  pathname?: string;
  menuData?: any;
}

const { title, description, lang = 'en', pathname, menuData } = Astro.props;
const currentLang = lang || (Astro.url.pathname.startsWith('/es') ? 'es' : 'en');
const currentPathname = pathname || Astro.url.pathname;
---

<Layout title={title} description={description} lang={currentLang} pathname={currentPathname} menuData={menuData}>
  <!-- Home Mobile Navigation -->
  <HomeMobileNavigation 
    client:load
    lang={currentLang}
    pathname={currentPathname}
  />
  
  <main>
    <slot />
  </main>
</Layout>

<style>
  /* No bottom padding needed since we removed the bottom navigation bar */
</style>
