---
import Layout from './Layout.astro';
import TableOfContents from '../components/core/navigation/TableOfContents.astro';
import { getAllContentData } from '../server/lib/contentData.js';
import { BookOpenIcon, ClockIcon, UserIcon, CalendarIcon, ArrowRightIcon, ShareIcon, DocumentArrowDownIcon, ChatBubbleLeftRightIcon } from '@heroicons/react/24/outline';
import SEOHead from '../components/core/SEOHead.astro';
import GuidesMobileNavigation from '../components/guides/GuidesMobileNavigation.tsx';
import GuidesBottomNavigation from '../components/guides/GuidesBottomNavigation.tsx';
import MobileBottomNavigation from '../components/core/layout/MobileBottomNavigation.tsx';
import { 
  generateSEOTitle, 
  generateSEODescription, 
  generateKeywords,
  type SEOData 
} from '../utils/seo.js';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  pathname?: string;
  headings?: any[];
  lastEdited?: string;
  menuData?: any;
  timeToRead?: number;
  author?: string;
  publishedDate?: string;
  content?: string; // Add content for SEO
  tags?: string[]; // Add tags for SEO
}

const { 
  title, 
  description, 
  lang = 'en', 
  pathname,
  headings = [],
  lastEdited,
  menuData,
  timeToRead = 5,
  author = 'Capital M Law',
  publishedDate,
  content: articleContent = '',
  tags = []
} = Astro.props;

// Get optimized menu data if not provided
const optimizedMenuData = menuData || await getAllContentData(lang);

// Get guides for sidebar navigation
const guidesData = optimizedMenuData?.allGuides || [];
const hasHeadings = headings && headings.length > 0;

// Get relative time
const getRelativeTime = (dateString: string) => {
  const date = new Date(dateString);
  const now = new Date();
  const diffInDays = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
  
  if (diffInDays === 0) return lang === 'es' ? 'Hoy' : 'Today';
  if (diffInDays === 1) return lang === 'es' ? 'Ayer' : 'Yesterday';
  if (diffInDays < 7) return lang === 'es' ? `Hace ${diffInDays} días` : `${diffInDays} days ago`;
  if (diffInDays < 30) return lang === 'es' ? `Hace ${Math.floor(diffInDays / 7)} semanas` : `${Math.floor(diffInDays / 7)} weeks ago`;
  if (diffInDays < 365) return lang === 'es' ? `Hace ${Math.floor(diffInDays / 30)} meses` : `${Math.floor(diffInDays / 30)} months ago`;
  return lang === 'es' ? `Hace ${Math.floor(diffInDays / 365)} años` : `${Math.floor(diffInDays / 365)} years ago`;
};

// Generate SEO data
const seoData: SEOData = {
  title: generateSEOTitle(title, 'guide', lang as 'en' | 'es'),
  description: generateSEODescription(articleContent, 'guide', lang as 'en' | 'es', description),
  keywords: generateKeywords(['guide', 'expat guide', 'Colombia'], 'guide', lang as 'en' | 'es', tags),
  author,
  publishedTime: publishedDate || lastEdited,
  modifiedTime: lastEdited,
  section: 'Legal Guides',
  tags,
  readingTime: timeToRead,
  lang: lang as 'en' | 'es',
  type: 'guide',
  canonicalUrl: `https://capitaleme.com${pathname}`
};
---

<Layout title={seoData.title} description={seoData.description} lang={lang as 'en' | 'es'} pathname={pathname} menuData={optimizedMenuData}>
  <SEOHead seoData={seoData} content={articleContent} pathname={pathname} slot="head" />
  
  <!-- Mobile Navigation -->
  <GuidesMobileNavigation 
    client:load
    headings={headings as any}
    currentSlug={Astro.params.slug}
    guides={guidesData}
    lang={lang}
  />

  <!-- Guides Bottom Navigation - Only for individual guides (not index) -->
  {Astro.params.slug && (
    <GuidesBottomNavigation 
      client:load
      lang={lang as 'en' | 'es'}
      pathname={pathname || ''}
      title={title}
      content={articleContent}
    />
  )}

  <!-- Mobile Bottom Navigation -->
  <MobileBottomNavigation 
    client:load
    lang={lang as 'en' | 'es'}
    title={title}
    content={articleContent}
    pathname={pathname}
  />

  <div class="bg-white">
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 py-16">
      <div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] -z-10"></div>
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-6">
            <BookOpenIcon className="w-8 h-8 text-blue-600" />
          </div>
          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 leading-tight">
            {title}
          </h1>
          {description && (
            <p class="text-xl text-slate-600 mb-8 max-w-3xl mx-auto leading-relaxed">
              {description}
            </p>
          )}
          
          <!-- Meta Information -->
          <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-slate-500 mb-8">
            {author && (
              <div class="flex items-center gap-2">
                <UserIcon className="w-4 h-4" />
                <span>{author}</span>
              </div>
            )}
            {publishedDate && (
              <div class="flex items-center gap-2">
                <CalendarIcon className="w-4 h-4" />
                <time datetime={publishedDate}>
                  {getRelativeTime(publishedDate)}
                </time>
              </div>
            )}
            <div class="flex items-center gap-2">
              <ClockIcon className="w-4 h-4" />
              <span>{timeToRead} {lang === 'en' ? 'min read' : 'min de lectura'}</span>
            </div>
            {lastEdited && (
              <div class="flex items-center gap-2">
                <CalendarIcon className="w-4 h-4" />
                <span>
                  {lang === 'es' ? 'Actualizado' : 'Updated'}: {getRelativeTime(lastEdited)}
                </span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>


    <!-- Main Content Section -->
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mt-[74px] lg:mt-0 pb-20 lg:pb-12">
      <div class="flex gap-8">
        <!-- Left Navigation Panel -->
        <aside class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-32">
            <nav class="space-y-6">
              <!-- Header -->
              <div class="pb-4 border-b border-slate-200">
                <h2 class="text-lg font-bold text-slate-900 mb-2">📚 {lang === 'es' ? 'Guías Legales' : 'Legal Guides'}</h2>
                <p class="text-sm text-slate-600">{lang === 'es' ? 'Recursos y guías paso a paso' : 'Step-by-step resources and guides'}</p>
              </div>

              <!-- Guides Navigation -->
              {guidesData.length > 0 && (
                <div class="space-y-2">
                  <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wide">
                    {lang === 'es' ? 'Guías Disponibles' : 'Available Guides'}
                  </h3>
                  <div class="space-y-1">
                    {guidesData.slice(0, 10).map((guide: any) => (
                      <a
                        href={guide.url || `/${lang}/guides/${guide.slug}`}
                        class={`block px-3 py-2 text-sm rounded-md transition-all duration-200 ${
                          guide.slug === Astro.params.slug
                            ? 'bg-blue-50 text-blue-700 border-l-4 border-blue-500'
                            : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900 border-l-4 border-transparent'
                        }`}
                      >
                        <div class="font-medium">{guide.title}</div>
                        {guide.description && (
                          <div class="text-xs text-slate-500 mt-1 line-clamp-2">
                            {guide.description}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <!-- Quick Links -->
              <div class="pt-4 border-t border-slate-200">
                <h3 class="text-sm font-semibold text-slate-900 mb-3">
                  {lang === 'es' ? 'Enlaces Rápidos' : 'Quick Links'}
                </h3>
                <div class="space-y-2">
                  <a href={`/${lang}/guides`} class="flex items-center px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors">
                    <span class="mr-2">🏠</span>
                    {lang === 'es' ? 'Inicio Guías' : 'Guides Home'}
                  </a>
                  <a href={`/${lang}/contact`} class="flex items-center px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors">
                    <span class="mr-2">📞</span>
                    {lang === 'es' ? 'Contáctanos' : 'Contact Us'}
                  </a>
                  <a href={`/${lang}/visas`} class="flex items-center px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors">
                    <span class="mr-2">🛂</span>
                    {lang === 'es' ? 'Visas' : 'Visas'}
                  </a>
                  <a href={`/${lang}/real-estate`} class="flex items-center px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 rounded-md transition-colors">
                    <span class="mr-2">🏠</span>
                    {lang === 'es' ? 'Bienes Raíces' : 'Real Estate'}
                  </a>
                </div>
              </div>
            </nav>
          </div>
        </aside>

        <!-- Main Content -->
        <article class="flex-1 min-w-0">
          <!-- Content -->
          <div class="prose prose-lg max-w-none prose-headings:scroll-mt-20 prose-slate prose-img:rounded-lg prose-img:shadow-md prose-img:mx-auto prose-img:max-w-full prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-a:font-medium prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-code:bg-slate-100 prose-code:text-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-strong:text-slate-900 prose-strong:font-semibold prose-blockquote:border-l-blue-500 prose-blockquote:bg-blue-50 prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:rounded-r-lg prose-ul:list-disc prose-ol:list-decimal prose-li:marker:text-slate-400 prose-table:border-collapse prose-th:border prose-th:border-slate-300 prose-th:bg-slate-50 prose-th:px-4 prose-th:py-2 prose-td:border prose-td:border-slate-300 prose-td:px-4 prose-td:py-2 prose-hr:border-slate-200 prose-hr:my-8">
            <slot />
          </div>
        </article>

        <!-- Right Table of Contents -->
        {hasHeadings && (
          <aside class="hidden xl:block w-80 shrink-0">
            <div class="sticky top-32">
              <TableOfContents headings={headings} lang={lang} />
            </div>
          </aside>
        )}
      </div>
    </div>

    <!-- Article Actions (Share, PDF, MD, Contact) -->

  </div>
</Layout>

<style>
  /* Smooth scroll behavior for the entire page */
  html {
    scroll-behavior: smooth;
  }

  /* Ensure headings have proper scroll margin for navbar offset */
  :global(h2, h3, h4, h5, h6) {
    scroll-margin-top: 160px;
  }

  /* Mobile-specific scroll margin for bottom navigation */
  @media (max-width: 1023px) {
    :global(h2, h3, h4, h5, h6) {
      scroll-margin-top: 200px;
    }
  }

  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  /* Mobile bottom nav padding */
  @media (max-width: 1024px) {
    body {
      padding-bottom: 80px;
    }
  }

  /* Content styling improvements */
  :global(.prose) {
    /* Handle long strings and prevent layout breaking */
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Images responsive handling */
  :global(.prose img) {
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 1.5rem auto;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: opacity 0.3s ease;
  }

  /* Image loading and error states */
  :global(.prose img[src=""]) {
    display: none;
  }

  :global(.prose img:not([src])) {
    display: none;
  }

  /* Fallback for broken images */
  :global(.prose img::before) {
    content: "🖼️ Image not available";
    display: block;
    text-align: center;
    color: #6b7280;
    font-style: italic;
    padding: 2rem;
    background-color: #f9fafb;
    border: 2px dashed #d1d5db;
    border-radius: 0.5rem;
  }

  /* Links styling */
  :global(.prose a) {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  :global(.prose a:hover) {
    color: #1d4ed8;
    text-decoration: underline;
  }

  /* Code blocks */
  :global(.prose pre) {
    background-color: #0f172a;
    color: #f1f5f9;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  :global(.prose code) {
    background-color: #f1f5f9;
    color: #1e293b;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* Tables responsive */
  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    overflow-x: auto;
    display: block;
    white-space: nowrap;
  }

  :global(.prose table thead) {
    display: table-header-group;
  }

  :global(.prose table tbody) {
    display: table-row-group;
  }

  :global(.prose table tr) {
    display: table-row;
  }

  :global(.prose table th),
  :global(.prose table td) {
    display: table-cell;
    padding: 0.75rem 1rem;
    border: 1px solid #e2e8f0;
    text-align: left;
  }

  :global(.prose table th) {
    background-color: #f8fafc;
    font-weight: 600;
  }

  /* Blockquotes */
  :global(.prose blockquote) {
    border-left: 4px solid #3b82f6;
    background-color: #eff6ff;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
  }

  /* Lists */
  :global(.prose ul),
  :global(.prose ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  :global(.prose li) {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  /* Headings */
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4),
  :global(.prose h5),
  :global(.prose h6) {
    color: #1e293b;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  :global(.prose h1) {
    font-size: 2.25rem;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  :global(.prose h2) {
    font-size: 1.875rem;
    color: #3b82f6;
  }

  :global(.prose h3) {
    font-size: 1.5rem;
  }

  /* Paragraphs */
  :global(.prose p) {
    margin: 1rem 0;
    line-height: 1.7;
    color: #374151;
  }

  /* Horizontal rules */
  :global(.prose hr) {
    border: none;
    border-top: 2px solid #e2e8f0;
    margin: 2rem 0;
  }

  /* Mobile responsive improvements */
  @media (max-width: 768px) {
    :global(.prose) {
      font-size: 1rem;
      line-height: 1.6;
    }

    :global(.prose h1) {
      font-size: 1.875rem;
    }

    :global(.prose h2) {
      font-size: 1.5rem;
    }

    :global(.prose h3) {
      font-size: 1.25rem;
    }

    :global(.prose img) {
      margin: 1rem auto;
    }

    :global(.prose table) {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Handle sticky header visibility
  document.addEventListener('DOMContentLoaded', () => {
    const stickyHeader = document.getElementById('sticky-header');
    const tocToggle = document.getElementById('toc-toggle');
    const mobileTocToggle = document.getElementById('mobile-toc-toggle');

    if (stickyHeader) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            stickyHeader.classList.remove('shadow-lg');
            stickyHeader.classList.add('shadow-sm');
          } else {
            stickyHeader.classList.remove('shadow-sm');
            stickyHeader.classList.add('shadow-lg');
          }
        },
        { threshold: 0.1 }
      );

      observer.observe(stickyHeader);
    }

    // Handle mobile TOC toggle
    if (mobileTocToggle) {
      mobileTocToggle.addEventListener('click', () => {
        const mobileTocButton = document.getElementById('mobile-toc-button');
        if (mobileTocButton) {
          mobileTocButton.click();
        }
      });
    }
  });
</script> 