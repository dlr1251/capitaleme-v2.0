      price: "$45 USD / 175,000 COP",
      duration: "45 minutes",
      includes: "What's Included:",
      features: [
        "Personalized legal assessment",
        "Detailed quote and timeline",
        "Bilingual consultation",
        "Follow-up support",
        "Clear next steps"
      ],
      paymentMethods: "Payment Methods:",
      methods: [
        "Bancolombia: 61400002492",
        "Stripe (Credit/Debit Cards)",
        "Revolut: @daniel8hsk"
      ]
    },
    
    // CTA
    cta: {
      title: "Ready to Start Your Legal Journey in Colombia?",
      subtitle: "Join hundreds of satisfied clients who have trusted Capital M Law for their legal needs.",
      consultation: "Book Consultation",
      whatsapp: "WhatsApp Chat"
    }
  },
  
  es: {
    header: "Cómo Trabajamos",
    subheader: "Dos modelos de servicio transparentes diseñados para tus necesidades legales en Colombia",
    
    serviceModels: {
      title: "Nuestros Modelos de Servicio",
      subtitle: "Elige el enfoque que mejor se adapte a tus necesidades legales",
      
      perService: {
        title: "Modelo por Servicio",
        subtitle: "Perfecto para necesidades legales específicas",
        description: "Ideal para clientes que necesitan asistencia con asuntos legales específicos como solicitudes de visa, registro de empresas o transacciones inmobiliarias.",
        steps: [
          { icon: "calendar", title: "Consulta Inicial", desc: "Sesión personalizada de 45 minutos para entender tus necesidades", price: "$45 USD" },
          { icon: "document", title: "Cotización Detallada", desc: "Propuesta integral con cronograma y costos" },
          { icon: "credit-card", title: "Pago Seguro", desc: "Múltiples opciones de pago para tu conveniencia" },
          { icon: "star", title: "Ejecución Profesional", desc: "Trabajo legal experto con actualizaciones regulares" }
        ],
