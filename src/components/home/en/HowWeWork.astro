        { icon: "computer", title: "Tecnología Avanzada", desc: "Aprovechando la tecnología para una práctica legal eficiente" },
        { icon: "chart", title: "Resultados Comprobados", desc: "Cientos de casos exitosos completados" }
      ]
    },
    
    consultation: {
      title: "Consulta Inicial",
      subtitle: "Tu primer paso hacia el éxito legal en Colombia",
