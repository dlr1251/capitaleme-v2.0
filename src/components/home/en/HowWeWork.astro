};

const t = content[lang] as typeof content['en'];

const getIcon = (iconName: string) => {
  const icons = {
    calendar: CalendarDaysIcon,
    document: DocumentTextIcon,
    "credit-card": CreditCardIcon,
    star: StarIcon,
    shield: ShieldCheckIcon,
    bolt: BoltIcon,
    globe: GlobeAltIcon,
    computer: ComputerDesktopIcon,
    chart: ChartBarIcon
  };
  return icons[iconName as keyof typeof icons] || CalendarDaysIcon;
};
---

<section class="py-24 bg-gradient-to-br from-slate-50 to-gray-100 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5" style={{
    backgroundImage: `url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`
  }}></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="text-left mb-20">
      <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-medium mb-6">
        <ShieldCheckIcon className="w-4 h-4" />
        {lang === 'en' ? 'Professional legal services' : 'Servicios legales profesionales'}
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-primary mb-6">{t.header}</h2>
      <p class="text-xl text-gray-600 leading-relaxed">{t.subheader}. {t.serviceModels.subtitle}.</p>
    </div>

    <!-- Service Models Section -->
    <div class="mb-24">      
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Per Service Model -->
        <div class="bg-white rounded-sm p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="text-center mb-8">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <DocumentTextIcon className="w-8 h-8 text-primary" />
            </div>
            <h4 class="text-2xl font-bold text-primary mb-2">{t.serviceModels.perService.title}</h4>
            <p class="text-lg text-primary font-semibold mb-3">{t.serviceModels.perService.subtitle}</p>
            <p class="text-gray-600">{t.serviceModels.perService.description}</p>
          </div>
          
          <!-- Steps -->
          <div class="space-y-6 mb-8">
            {t.serviceModels.perService.steps.map((step, idx) => {
              const IconComponent = getIcon(step.icon);
              return (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-primary font-bold text-sm">{idx + 1}</span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between mb-1">
                      <h5 class="font-semibold text-gray-900">{step.title}</h5>
                      {step.price && <span class="text-sm font-medium text-primary">{step.price}</span>}
                    </div>
                    <p class="text-gray-600 text-sm">{step.desc}</p>
                  </div>
                </div>
              );
            })}
          </div>
          
          <!-- Features -->
          <div class="border-t border-gray-200 pt-6">
            <h6 class="font-semibold text-gray-900 mb-3">{lang === 'en' ? 'Key Benefits:' : 'Beneficios Clave:'}</h6>
            <div class="space-y-2">
              {t.serviceModels.perService.features.map((feature) => (
                <div class="flex items-center gap-2">
                  <CheckCircleIcon className="w-4 h-4 text-green-500" />
                  <span class="text-sm text-gray-600">{feature}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Retainer Model -->
        <div class="bg-white rounded-sm p-8 shadow-lg border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="text-center mb-8">
            <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <ClockIcon className="w-8 h-8 text-secondary" />
            </div>
            <h4 class="text-2xl font-bold text-secondary mb-2">{t.serviceModels.retainer.title}</h4>
            <p class="text-lg text-secondary font-semibold mb-3">{t.serviceModels.retainer.subtitle}</p>
            <p class="text-gray-600">{t.serviceModels.retainer.description}</p>
          </div>
          
          <!-- Features -->
          <div class="space-y-4 mb-8">
            <h6 class="font-semibold text-gray-900">{lang === 'en' ? 'What You Get:' : 'Lo que Obtienes:'}</h6>
            <div class="space-y-2">
              {t.serviceModels.retainer.features.map((feature) => (
                <div class="flex items-center gap-2">
                  <CheckCircleIcon className="w-4 h-4 text-secondary" />
                  <span class="text-sm text-gray-600">{feature}</span>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Benefits -->
          <div class="border-t border-gray-200 pt-6">
            <h6 class="font-semibold text-gray-900 mb-3">{lang === 'en' ? 'Why Choose Retainer:' : 'Por qué Elegir Retainer:'}</h6>
            <div class="space-y-2">
              {t.serviceModels.retainer.benefits.map((benefit) => (
                <div class="flex items-center gap-2">
                  <StarIcon className="w-4 h-4 text-primary" />
                  <span class="text-sm text-gray-600">{benefit}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Initial Consultation -->
    <div class="mb-24">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-sm p-8 shadow-lg border border-gray-200">
          <div class="text-center mb-8">
            <h3 class="text-3xl font-bold text-gray-900 mb-4">{t.consultation.title}</h3>
            <p class="text-xl text-gray-600 mb-6">{t.consultation.subtitle}</p>
            <div class="inline-flex items-center gap-4 bg-primary/10 text-primary px-6 py-3 rounded-full">
              <ClockIcon className="w-5 h-5" />
              <span class="font-semibold">{t.consultation.duration}</span>
              <span class="text-lg font-bold">•</span>
              <span class="font-semibold">{t.consultation.price}</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- What's Included -->
            <div>
              <h4 class="font-semibold text-gray-900 mb-4">{t.consultation.includes}</h4>
              <div class="space-y-3">
                {t.consultation.features.map((feature) => (
                  <div class="flex items-center gap-3">
                    <CheckCircleIcon className="w-5 h-5 text-green-500" />
                    <span class="text-gray-700">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
            
            <!-- Payment Methods -->
            <div>
              <h4 class="font-semibold text-gray-900 mb-4">{t.consultation.paymentMethods}</h4>
              <div class="space-y-3">
                {t.consultation.methods.map((method) => (
                  <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                    <CreditCardIcon className="w-5 h-5 text-primary" />
                    <span class="text-gray-700 font-medium">{method}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section> 