        steps: [
          { icon: "calendar", title: "Consulta inicial", desc: "Sesión personalizada de 45 minutos para entender tus necesidades", price: "$55 USD" },
          { icon: "document", title: "Cotización detallada", desc: "Propuesta integral con cronograma y costos" },
