          "Precios fijos para transparencia",
          "Entregables y cronograma claros",
          "Sin costos ocultos o sorpresas",
          "Comunicación directa durante todo el proceso"
        ]
      },
      
      retainer: {
        title: "Modelo de Retainer",
        subtitle: "Para apoyo legal continuo",
