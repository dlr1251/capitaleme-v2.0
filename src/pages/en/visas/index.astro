---
export const prerender = false; // SSR: Get visas dynamically from Supabase
import Layout from "../../../layouts/Layout.astro";
import { getAllContentData } from '../../../server/lib/contentData.js';
import { getAllVisas } from '../../../server/lib/getVisa.js';
import BlogPageLatest from '../../../components/blog/BlogPageLatest.astro';
import VisasHero from '../../../components/visas/VisasHero.tsx';
import ServicesSection from '../../../components/visas/ServicesSection.tsx';
import ToolsSection from '../../../components/visas/ToolsSection.tsx';

const lang = 'en';

// Get visas directly from Supabase
const allVisas = await getAllVisas(lang, false);

// Get menu data for sidebar navigation
const menuData = await getAllContentData(lang);
const allGuides = menuData?.allGuides || [];

// Get popular visas
const popularVisas = allVisas.filter((visa: any) => visa.isPopular).slice(0, 9);

// Get featured guides
const featuredGuides = allGuides.filter((guide: any) => guide.isFeatured).slice(0, 4);
---

<Layout title="Visa Information - Capital M Law | Colombian Legal Services" lang={lang} menuData={menuData}>
  
  <!-- Hero Section -->
  <VisasHero client:load guides={featuredGuides} lang="en" />
  
  <!-- Services Section (with tabs: Our Service, Additional Services, FAQ) -->
  <ServicesSection client:load lang="en" />
  
  <!-- Tools Section (with tabs: Visa Explorer, Days Calculator) -->
  <ToolsSection client:load visas={allVisas} lang="en" />
  
  <!-- Latest Blog Posts Section -->
  <div class="py-20 bg-gray-50">
    <BlogPageLatest/>
  </div>
</Layout> 